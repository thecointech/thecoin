{
  "name": "@thecointech/bank-interface",
  "version": "0.6.6",
  "description": "The Coin: Generic banking interface.  Contains no implementation.",
  "type": "module",
  "keywords": [
    "TheCoin",
    "Bank",
    "API"
  ],
  "author": "Stephen Taylor <stephen@thecoin.io>",
  "homepage": "http://thecoin.io",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecointech/thecoin.git",
    "directory": "libs/tx-statemachine"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "prepublishOnly": "yarn run -T rimraf ./build/.buildinfo ./mocks/.build/.buildinfo",
    "build": "run -T tsc -b tsconfig.json",
    "clean": "run -T rimraf ./build && run -T rimraf ./mocks/.build"
  },
  "files": [
    "build/**/*",
    "mocks/.build/**/*"
  ],
  "exports": {
    ".": "./build/index.js",
    "./mocked": "./mocks/.build/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "build/*"
      ],
      "mocked": [
        "mocks/.build/index.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@thecointech/types": "^0.6.6"
  }
}

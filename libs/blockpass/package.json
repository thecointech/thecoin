{
  "name": "@thecointech/blockpass",
  "version": "0.6.8-test.0",
  "description": "TheCoin: Wrapper for blockpass for web",
  "type": "module",
  "keywords": [
    "TheCoin",
    "Blockpass"
  ],
  "author": "Stephen Taylor <stephen@thecoin.io>",
  "homepage": "http://thecoin.io",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecointech/thecoin.git",
    "directory": "libs/blockpass"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "run -T tsc -b",
    "clean": "rimraf ./build && rimraf ./coverage"
  },
  "files": [
    "build/**/*"
  ],
  "exports": {
    ".": {
      "development": "./mocks/index.ts",
      "devlive": "./mocks/index.ts",
      "default": "./build/index.js"
    },
    "./fetch": {
      "development": "./mocks/fetch.ts",
      "devlive": "./mocks/fetch.ts",
      "default": "./build/fetch.js"
    },
    "./types": "./src/types.ts"
  },
  "typesVersions": {
    "*": {
      "types": [
        "src/types.ts"
      ],
      "*": [
        "build/*.d.ts"
      ]
    }
  },
  "dependencies": {
    "@thecointech/apis": "^0.6.8-test.0",
    "@thecointech/secrets": "^0.6.8-test.0"
  },
  "devDependencies": {
    "@thecointech/async": "^0.6.8-test.0",
    "@thecointech/broker-cad": "^0.6.8-test.0"
  }
}

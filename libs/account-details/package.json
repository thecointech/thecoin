{
  "name": "@thecointech/account-details",
  "version": "0.6.7",
  "description": "The Coin: Encrypted user details (profile & KYC records)",
  "type": "module",
  "keywords": [
    "THECoin",
    "ethereum"
  ],
  "author": "Stephen Taylor <stephen@thecoin.io>",
  "homepage": "http://thecoin.io",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecointech/thecoin.git",
    "directory": "libs/account-details"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "prepublishOnly": "yarn run -T rimraf ./build/.buildinfo",
    "build": "run -T tsc -b",
    "clean": "rimraf ./build && rimraf ./coverage",
    "test": "run :jest",
    "test:summary": "jest --coverage > ./coverage/summary.txt"
  },
  "files": [
    "build/**/*"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./src/types.ts"
  },
  "typesVersions": {
    "*": {
      "types": [
        "src/types.ts"
      ],
      "*": [
        "build/*.d.ts"
      ]
    }
  },
  "dependencies": {
    "@thecointech/fx-rates": "^0.6.7",
    "ethers": "6.15.0",
    "luxon": "3.3.0"
  },
  "devDependencies": {
    "@thecointech/jestutils": "^0.6.7"
  }
}
